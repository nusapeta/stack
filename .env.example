# Copy to .env and edit. `docker compose` reads this file automatically.
DATA_DIR=./data
NUSAPETA_PORT=8080
NUSAPETA_ROUTE_IMAGE=ghcr.io/nusapeta/route:0.1.0
NUSAPETA_PLACE_IMAGE=ghcr.io/nusapeta/place:0.1.0

# File names inside DATA_DIR. Use java-mini.graph / places-mini.idx for the
# committed fixtures.
NUSAPETA_ROUTE_GRAPH=java.graph
NUSAPETA_PLACE_INDEX=places-2026.11.idx
NUSAPETA_PLACE_MANIFEST=places-2026.11.idx.json

# Override the data release tag when bootstrapping.
NUSAPETA_DATA_TAG=data-2026.11
